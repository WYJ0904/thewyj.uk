{
  "name": "thewyj-uk-pages",
  "private": true,
  "version": "0.0.0",
  "description": "Cloudflare Pages development tooling for thewyj.uk",
  "scripts": {
    "cf:check": "wrangler pages functions build functions --outdir .wrangler/functions-build",
    "cf:types": "wrangler types .wrangler/worker-configuration.d.ts --env production",
    "cf:migrate:local": "wrangler d1 migrations apply WYJ_DB --local --persist-to .wrangler/state",
    "cf:dev": "wrangler pages dev --persist-to .wrangler/state --port 8788"
  },
  "devDependencies": {
    "wrangler": "4.118.0"
  }
}
