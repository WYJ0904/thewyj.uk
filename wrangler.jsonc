        "CLOUD_DEEP_HEALTH_CHECKS": "true",
        "LEGACY_API_FALLBACK_ENABLED": "false",
        "TASK11_IMPORT_ENABLED": "true",
        "TASK11_PRODUCTION_IMPORT_ENABLED": "false"
      },
      "d1_databases": [
