{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thewyj-uk",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-08-06",
  "send_metrics": false,
  "vars": {
    "WYJ_ENVIRONMENT": "development",
    "CLOUD_FOUNDATION_ENABLED": "true",
    "CLOUD_STATUS_MODE": "cloud",
    "CLOUD_READS_ENABLED": "true",
    "CLOUD_WRITES_ENABLED": "true",
    "TASK11_CLOUD_READS_ENABLED": "true",
    "TASK11_CLOUD_WRITES_ENABLED": "true",
    "TASK12_CLOUD_ACCOUNTS_ENABLED": "true",
    "TASK12_IMPORT_ENABLED": "false",
    "TASK12_PRODUCTION_IMPORT_ENABLED": "false",
    "TASK13_CLOUD_READS_ENABLED": "true",
    "TASK13_CLOUD_WRITES_ENABLED": "true",
    "TASK13_IMPORT_ENABLED": "false",
    "TASK13_PRODUCTION_IMPORT_ENABLED": "false",
    "TASK13_PAYMENT_PRIMARY_ENABLED": "true",
    "TASK14_CLOUD_READS_ENABLED": "true",
    "TASK14_CLOUD_WRITES_ENABLED": "true",
    "TASK14_IMPORT_ENABLED": "false",
    "TASK14_PRODUCTION_IMPORT_ENABLED": "false",
    "TASK14_TEMPORARY_PRIMARY_ENABLED": "true",
    "TASK14_LEGACY_WRITES_FROZEN": "true",
    "TASK15_CLOUD_ONLY_ENABLED": "true",
    "TASK15_IMPORT_ENABLED": "false",
    "TASK15_PRODUCTION_IMPORT_ENABLED": "false",
    "TASK16_CLOUD_READS_ENABLED": "false",
    "TASK16_CLOUD_WRITES_ENABLED": "false",
    "TASK16_IMPORT_ENABLED": "false",
    "TASK16_PRODUCTION_IMPORT_ENABLED": "false",
    "TASK18_ADMIN_MESSAGES_ENABLED": "true",
    "TASK20_ANDROID_APP_ENABLED": "true",
    "TASK21_NOTIFICATION_READS_ENABLED": "false",
    "TASK21_NOTIFICATION_WRITES_ENABLED": "false",
    "TASK22_TRANSFER_READS_ENABLED": "true",
    "TASK22_TRANSFER_WRITES_ENABLED": "true",
    "ANDROID_LATEST_VERSION_CODE": "20",
    "ANDROID_LATEST_VERSION_NAME": "1.3.7",
    "ANDROID_MINIMUM_VERSION_CODE": "1",
    "ANDROID_DOWNLOAD_URL": "",
    "ANDROID_RELEASE_DATE": "2026-09-14",
    "ANDROID_RELEASE_BUILD": "2026-09-14-task24-payment-lifecycle-r3",
    "ANDROID_RELEASE_NOTES": "Task 24 支付生命周期收口版：同一 Android 通知在移除前复用一个支付事件标识，微信更新 postTime 不再产生重复待核实记录；设备 OCR 核实后的金额可沿原事件 ID 确认记账，服务端原子关闭 pending hint，重复确认不会重复入账。",
    "ANDROID_APK_FILE_NAME": "thewyj-android-1.3.7.apk",
    "ANDROID_APK_KEY": "app/android/thewyj-android-1.3.7.apk",
    "ANDROID_APK_SHA256": "db44cb9222c3faf938c891fd1b475481616ad8cf4b9d0d23974e1d77d5ebdab2",
    "ANDROID_APK_SIZE_BYTES": "47611289",
    "WORKERS_AI_ENABLED": "false",
    "D1_RATE_LIMIT_ENABLED": "true",
    "CLOUD_RATE_LIMIT_REQUESTS": "120",
    "CLOUD_RATE_LIMIT_WINDOW_SECONDS": "60",
    "CLOUD_DEEP_HEALTH_CHECKS": "true",
    "LEGACY_API_FALLBACK_ENABLED": "false",
    "TASK11_IMPORT_ENABLED": "false",
    "TASK11_PRODUCTION_IMPORT_ENABLED": "false"
  },
  "env": {
    "preview": {
      "vars": {
        "WYJ_ENVIRONMENT": "preview",
        "CLOUD_FOUNDATION_ENABLED": "true",
        "CLOUD_STATUS_MODE": "cloud",
        "CLOUD_READS_ENABLED": "true",
        "CLOUD_WRITES_ENABLED": "true",
        "TASK11_CLOUD_READS_ENABLED": "true",
        "TASK11_CLOUD_WRITES_ENABLED": "true",
        "TASK12_CLOUD_ACCOUNTS_ENABLED": "true",
        "TASK12_IMPORT_ENABLED": "true",
