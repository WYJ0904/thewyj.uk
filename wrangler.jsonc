        "ANDROID_RELEASE_BUILD": "2026-09-11-task24-1-closure",
        "ANDROID_RELEASE_NOTES": "通知保存升级为独立模块：普通消息到达即自动保存快照，撤回/替换/清除后历史仍在；新增通知分类层，常驻通知、下载进度与网速流量默认不写入历史，Clash 类每秒刷新不再造成闪烁或 IO 增长；通知历史支持收藏（收藏不被自动删除），保存期限新增 7 天/30 天/90 天/1 年/永久并显示占用；通知历史与自动记账彻底解耦，只买财务权益也能记账；手机端语言学习页的智能选词与本轮统计默认收起。",
        "ANDROID_APK_FILE_NAME": "thewyj-android-1.2.6.apk",
        "ANDROID_APK_KEY": "app/android/thewyj-android-1.2.6.apk",
        "ANDROID_APK_SHA256": "88d973d9f0d45f06f69ee634f81e5b66d9b80974a65e3710d4d6254b375446cd",
        "ANDROID_APK_SIZE_BYTES": "1849547",
        "WORKERS_AI_ENABLED": "true",
        "D1_RATE_LIMIT_ENABLED": "true",
        "CLOUD_RATE_LIMIT_REQUESTS": "120",
        "CLOUD_RATE_LIMIT_WINDOW_SECONDS": "60",
        "CLOUD_DEEP_HEALTH_CHECKS": "true",
        "LEGACY_API_FALLBACK_ENABLED": "false",
        "TASK11_IMPORT_ENABLED": "true",
        "TASK11_PRODUCTION_IMPORT_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "WYJ_DB",
          "database_name": "wyj-cloud-preview",
          "database_id": "a3e6253b-689f-49f3-998b-7c5828ea255a",
          "migrations_table": "wyj_d1_migrations",
          "migrations_dir": "cloudflare/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "WYJ_STORAGE",
          "bucket_name": "wyj-cloud-preview"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "vars": {
        "WYJ_ENVIRONMENT": "production",
        "CLOUD_FOUNDATION_ENABLED": "true",
