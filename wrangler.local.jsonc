{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thewyj-uk-local",
  "compatibility_date": "2026-08-06",
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "WYJ_DB",
      "database_name": "wyj-cloud-development",
      "migrations_table": "wyj_d1_migrations",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WYJ_STORAGE",
      "bucket_name": "wyj-cloud-development"
    }
  ]
}
